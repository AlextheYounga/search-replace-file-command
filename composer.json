{
    "name": "alextheyounga/search-replace-file-command",
    "type": "wp-cli-package",
    "description": "Performs serialization-aware search and replace on WordPress SQL dump files.",
    "homepage": "https://github.com/AlextheYounga/search-replace-file-command",
    "license": "MIT",
    "authors": [
        {
            "name": "Alex Younger"
        }
    ],
    "require": {
        "wp-cli/wp-cli": "^2.12 || ^3"
    },
    "require-dev": {
        "wp-cli/wp-cli-tests": "^5"
    },
    "config": {
        "lock": false,
        "process-timeout": 7200,
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "johnpbloch/wordpress-core-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.x-dev"
        },
        "bundled": false,
        "commands": [
            "search-replace-file"
        ]
    },
    "autoload": {
        "classmap": [
            "src/"
        ],
        "files": [
            "search-replace-file-command.php"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "behat": "run-behat-tests",
        "behat-rerun": "rerun-behat-tests",
        "lint": "run-linter-tests",
        "phpcs": "run-phpcs-tests",
        "phpstan": "run-phpstan-tests",
        "phpcbf": "run-phpcbf-cleanup",
        "phpunit": "run-php-unit-tests",
        "prepare-tests": "install-package-tests",
        "spellcheck": "typos",
        "gherkin-lint": "npx --no-install gherkin-lint -c .gherkin-lintrc features/*.feature",
        "test": [
            "@lint",
            "@phpcs",
            "@phpstan",
            "@phpunit",
            "@behat",
            "@spellcheck",
            "@gherkin-lint"
        ]
    },
    "support": {
        "issues": "https://github.com/AlextheYounga/search-replace-file-command/issues"
    }
}
